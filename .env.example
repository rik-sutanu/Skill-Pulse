# ==============================================================================
# SkillPulse Environment Configuration
# ==============================================================================
# WARNING: Do not commit sensitive SMTP passwords, API keys, or database credentials.

# ------------------------------------------------------------------------------
# 1. Direct Database Connection (PostgreSQL / Supabase / MySQL via PDO)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection Parameters
# DB_DRIVER: 'pgsql' (PostgreSQL / Supabase) or 'mysql'
DB_DRIVER=pgsql

# Database Host (e.g. db.your-project-id.supabase.co or aws-0-ap-south-1.pooler.supabase.com)
DB_HOST=db.your-project-id.supabase.co

# Database Port (5432 for Direct Connection, 6543 for Supabase Connection Pooler)
DB_PORT=5432

# Database Name (default: postgres)
DB_NAME=postgres

# Database User (default: postgres or postgres.your-project-id)
DB_USER=postgres

# Database Password (your database password)
DB_PASSWORD=your-database-password

# SSL Mode ('require' for Supabase Cloud, 'prefer' or 'disable' for local)
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 2. Supabase REST API ('skill-pulse') Configuration
# ------------------------------------------------------------------------------
# In your Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Tawk.to Live Chat Widget Configuration
# ------------------------------------------------------------------------------
TAWKTO_PROPERTY_ID=your-tawkto-property-id
TAWKTO_WIDGET_ID=default

# ------------------------------------------------------------------------------
# 4. Transactional Mailer (PHPMailer with SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="SkillPulse"
