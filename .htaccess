# ==============================================================================
# SkillPulse Production Apache Configuration (.htaccess)
# ==============================================================================

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header for JWT and Bearer Tokens
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect trailing slashes if not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
</IfModule>

# 2. Block Direct Access to Sensitive Files and Directories
<FilesMatch "^\.(env|git|gitignore|dockerignore)">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|Dockerfile|render\.yaml)$">
    Require all denied
</FilesMatch>

# Prevent direct web browser download of internal backend storage files
<IfModule mod_rewrite.c>
    RewriteRule ^backend/(.*)\.json$ - [F,L]
    RewriteRule ^backend/secure_uploads/ - [F,L]
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 4. MIME Types and Charset
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType text/html .php .html
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# 5. Directory Index Order
DirectoryIndex index.php index.html
